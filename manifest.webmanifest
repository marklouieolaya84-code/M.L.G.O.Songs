{
 "id": "./",
 "name": "M.L.G.O",
 "short_name": "MLGO",
 "description": "Local music player with folder connect and true no-repeat shuffle",
 "start_url": "./?source=pwa",
 "scope": "./",
 "lang": "en",
 "dir": "ltr",
 "display": "standalone",
 "display_override": [
  "window-controls-overlay",
  "standalone",
  "tabbed"
 ],
 "orientation": "portrait",
 "background_color": "#0d0d0d",
 "theme_color": "#0d0d0d",
 "categories": [
  "music",
  "entertainment"
 ],
 "prefer_related_applications": false,
 "related_applications": [],
 "scope_extensions": [],
 "icons": [
  {
   "src": "data:image/png;base64,",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "data:image/png;base64,",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "data:image/png;base64,",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "shortcuts": [
  {
   "name": "Liked songs",
   "url": "./?view=liked"
  },
  {
   "name": "Songlist",
   "url": "./?view=songs"
  },
  {
   "name": "Search",
   "url": "./?view=search"
  }
 ],
 "file_handlers": [
  {
   "action": "./",
   "accept": {
    "audio/*": [
     ".mp3",
     ".m4a",
     ".wav",
     ".ogg",
     ".flac",
     ".aac",
     ".opus"
    ]
   }
  }
 ],
 "launch_handler": {
  "client_mode": [
   "focus-existing",
   "auto"
  ]
 },
 "protocol_handlers": [
  {
   "protocol": "web+mlgo",
   "url": "./?uri=%s"
  }
 ],
 "share_target": {
  "action": "./",
  "method": "GET",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url"
  }
 },
 "edge_side_panel": {
  "preferred_width": 400
 },
 "note_taking": {
  "new_note_url": "./?view=songs"
 }
}