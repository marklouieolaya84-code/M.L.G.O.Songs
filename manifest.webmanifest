{
  "id": "/?app=mlgo",
  "name": "M.L.G.O",
  "short_name": "MLGO",
  "description": "Local music player with folder connect and true no-repeat shuffle",
  "start_url": "/?source=pwa",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "tabbed"],
  "orientation": "portrait",
  "background_color": "#0d0d0d",
  "theme_color": "#0d0d0d",
  "categories": ["music", "entertainment"],
  "prefer_related_applications": false,
  "related_applications": [],
  "scope_extensions": [],
  "icons": [
    {"src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "screenshots": [
    {"src": "/shots/narrow.png", "sizes": "720x1144", "type": "image/png", "form_factor": "narrow", "label": "Home"},
    {"src": "/shots/wide.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Home"}
  ],
  "shortcuts": [
    {"name": "Liked songs", "url": "/?view=liked", "icons": [{"src": "/icons/icon-192.png", "sizes": "192x192"}]},
    {"name": "Songlist", "url": "/?view=songs", "icons": [{"src": "/icons/icon-192.png", "sizes": "192x192"}]},
    {"name": "Search", "url": "/?view=search", "icons": [{"src": "/icons/icon-192.png", "sizes": "192x192"}]}
  ],
  "file_handlers": [
    {"action": "/", "accept": {"audio/*": [".mp3", ".m4a", ".wav", ".ogg", ".flac", ".aac", ".opus"]}}
  ],
  "launch_handler": {"client_mode": ["focus-existing", "auto"]},
  "protocol_handlers": [{"protocol": "web+mlgo", "url": "/?uri=%s"}],
  "share_target": {"action": "/", "method": "GET", "params": {"title": "title", "text": "text", "url": "url"}},
  "edge_side_panel": {"preferred_width": 400},
  "note_taking": {"new_note_url": "/?view=songs"}
}
